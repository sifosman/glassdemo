      "parameters": {
        "jsCode": "// Grab the data from the Webhook and Supabase nodes\nconst webhookData = $('Webhook').first().json.body;\n// Supabase GET node returns an array, we need the first item\nconst supabaseData = $input.first().json;\n\n// Parse the quote data safely\nlet parsedItems = [];\nif (typeof supabaseData.quote_data === 'string') {\n  parsedItems = JSON.parse(supabaseData.quote_data);\n} else {\n  parsedItems = supabaseData.quote_data;\n}\n\n// FIX: Ensure every item has a frameColor so the Next.js API doesn't crash\nparsedItems = parsedItems.map(item => ({\n  ...item,\n  frameColor: item.frameColor || \"Silver\" // Default to Silver if the AI missed it\n}));\n\n// Build the perfect payload for your Next.js API\nconst payload = {\n  customer: {\n    name: webhookData.subscriber_name || 'Customer',\n    email: \"Test@example.com\",\n    phone: webhookData.chat_id,\n    address: webhookData.custom_fields?.customer_address || \"Test Address\"\n  },\n  items: parsedItems,\n  whatsappUserId: webhookData.chat_id\n};\n\n// Return it so the next node can just grab it cleanly\nreturn [{ json: { myPayload: payload } }];"
