{
  "name": "Glass Quote Bot - Payment Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "payfast-notify",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "id": "payfast-webhook",
      "name": "PayFast ITN Webhook",
      "webhookId": "payfast-notify"
    },
    {
      "parameters": {
        "jsCode": "// Verify PayFast signature and extract payment data\nconst crypto = require('crypto');\nconst data = $input.first().json.body || $input.first().json;\n\nconst PAYFAST_PASSPHRASE = process.env.PAYFAST_PASSPHRASE || '';\n\n// Build parameter string for signature verification\nconst params = { ...data };\ndelete params.signature;\n\nconst sortedKeys = Object.keys(params).sort();\nconst paramPairs = sortedKeys\n  .filter(key => params[key] !== '' && params[key] !== undefined)\n  .map(key => `${key}=${encodeURIComponent(params[key]).replace(/%20/g, '+')}`);\n\nlet paramString = paramPairs.join('&');\nif (PAYFAST_PASSPHRASE) {\n  paramString += `&passphrase=${encodeURIComponent(PAYFAST_PASSPHRASE)}`;\n}\n\nconst calculatedSignature = crypto.createHash('md5').update(paramString).digest('hex');\nconst isValid = calculatedSignature === data.signature;\n\nif (!isValid) {\n  throw new Error('Invalid PayFast signature');\n}\n\nreturn [{\n  json: {\n    signatureValid: true,\n    quoteId: data.m_payment_id,\n    amount: parseFloat(data.amount_gross),\n    paymentId: data.pf_payment_id,\n    paymentStatus: data.payment_status,\n    customerPhone: data.custom_str1,\n    quoteNumber: data.custom_str2,\n    customerName: `${data.name_first} ${data.name_last}`.trim(),\n    customerEmail: data.email_address,\n    rawData: data\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "id": "verify-signature",
      "name": "Verify PayFast Signature"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.paymentStatus }}",
              "value2": "COMPLETE"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [440, 300],
      "id": "check-payment-complete",
      "name": "Payment Complete?"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/quotes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "eq.{{ $json.quoteId }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "paid"
            },
            {
              "name": "deposit_paid",
              "value": "={{ $json.amount }}"
            },
            {
              "name": "deposit_paid_at",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200],
      "id": "update-quote-status",
      "name": "Update Quote Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/payments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "quote_id",
              "value": "={{ $json.quoteId }}"
            },
            {
              "name": "amount",
              "value": "={{ $json.amount }}"
            },
            {
              "name": "payment_method",
              "value": "payfast"
            },
            {
              "name": "payfast_payment_id",
              "value": "={{ $json.paymentId }}"
            },
            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "gateway_response",
              "value": "={{ JSON.stringify($json.rawData) }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 200],
      "id": "record-payment",
      "name": "Record Payment",
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.botsailor.com/api/v1/whatsapp/send-message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $('Verify PayFast Signature').first().json.customerPhone }}"
            },
            {
              "name": "message",
              "value": "✅ *Payment Received!*\n\nThank you for your deposit of R{{ $('Verify PayFast Signature').first().json.amount.toFixed(2) }}\n\n📋 Reference: {{ $('Verify PayFast Signature').first().json.paymentId }}\n📄 Quote: {{ $('Verify PayFast Signature').first().json.quoteNumber }}\n\n*What happens next:*\n1️⃣ We'll call you within 24 hours\n2️⃣ Site measurement arranged\n3️⃣ Manufacturing: 5-7 working days\n4️⃣ Installation at your convenience\n\n📧 Invoice sent to your email\n📞 Questions? Call 011 XXX XXXX"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 200],
      "id": "send-whatsapp-confirmation",
      "name": "Send WhatsApp Confirmation",
      "credentials": {
        "httpHeaderAuth": {
          "id": "BOTSAILOR_CREDENTIAL_ID",
          "name": "BotSailor API"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.FROM_EMAIL }}",
        "toEmail": "={{ $env.COMPANY_EMAIL }}",
        "subject": "💰 Payment Received - Quote {{ $('Verify PayFast Signature').first().json.quoteNumber }}",
        "text": "New payment received!\n\nQuote: {{ $('Verify PayFast Signature').first().json.quoteNumber }}\nAmount: R{{ $('Verify PayFast Signature').first().json.amount.toFixed(2) }}\nReference: {{ $('Verify PayFast Signature').first().json.paymentId }}\nCustomer: {{ $('Verify PayFast Signature').first().json.customerName }}\nPhone: {{ $('Verify PayFast Signature').first().json.customerPhone }}\n\nPlease contact customer within 24 hours to arrange site measurement.",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1320, 200],
      "id": "email-company",
      "name": "Email Company Notification"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "quote_id",
              "value": "eq.{{ $('Verify PayFast Signature').first().json.quoteId }}"
            },
            {
              "name": "status",
              "value": "eq.pending"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "cancelled"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 200],
      "id": "cancel-reminders",
      "name": "Cancel Pending Reminders",
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1760, 300],
      "id": "respond-ok",
      "name": "Respond OK"
    }
  ],
  "connections": {
    "PayFast ITN Webhook": {
      "main": [
        [
          {
            "node": "Verify PayFast Signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify PayFast Signature": {
      "main": [
        [
          {
            "node": "Payment Complete?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Payment Complete?": {
      "main": [
        [
          {
            "node": "Update Quote Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Quote Status": {
      "main": [
        [
          {
            "node": "Record Payment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Payment": {
      "main": [
        [
          {
            "node": "Send WhatsApp Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Confirmation": {
      "main": [
        [
          {
            "node": "Email Company Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Company Notification": {
      "main": [
        [
          {
            "node": "Cancel Pending Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cancel Pending Reminders": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "meta": {
    "instanceId": "glass-quote-bot"
  },
  "tags": [
    {
      "name": "glass-bot"
    },
    {
      "name": "payments"
    }
  ]
}
